.community-list-wrap .community-item {
  background: #FFFFFF;
  margin-top: 20rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}
.community-list-wrap .community-item .title-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 686rpx;
}
.community-list-wrap .community-item .title-box .left {
  display: flex;
  align-items: center;
}
.community-list-wrap .community-item .title-box .left > image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 22rpx;
}
.community-list-wrap .community-item .title-box .left .title-info .title {
  font-size: 30rpx;
  color: #221F1C;
}
.community-list-wrap .community-item .title-box .left .title-info .time {
  font-size: 24rpx;
  color: #A8A8A8;
}
.community-list-wrap .community-item .content-txt {
  font-size: 30rpx;
  color: #332E2A;
  line-height: 44rpx;
  margin-top: 32rpx;
  margin-bottom: 20rpx;
  text-align: justify;
}
.community-list-wrap .community-item .img-list {
  display: flex;
  align-items: center;
}
.community-list-wrap .community-item .img-list > image {
  width: 220rpx;
  height: 220rpx;
  margin-right: 12rpx;
  border-radius: 5rpx;
}
.community-list-wrap .community-item .img-list :last-child {
  margin-right: 0;
}
.community-list-wrap .community-item .pj {
  width: 686rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 36rpx;
}
.community-list-wrap .community-item .pj > image {
  width: 36rpx;
  height: 36rpx;
  margin-left: 40rpx;
  margin-right: 10rpx;
}
.community-list-wrap .community-item .pj text {
  font-size: 28rpx;
  color: #000000;
}
.community-list-wrap .community-item .dz {
  font-size: 28rpx;
  color: #221F1C;
  line-height: 40rpx;
  padding: 28rpx 0;
  text-align: justify;
}
.community-list-wrap .community-item .replay {
  border-top: 1rpx solid #E6E6E6;
  padding-top: 15rpx;
}
.community-list-wrap .community-item .replay > view {
  font-size: 28rpx;
  color: #221F1C;
  margin-top: 20rpx;
}
.community-list-wrap .community-item .replay > view .name {
  color: #80766C;
}
.community-list-wrap .community-item .replay > view .margin-5 {
  margin: 0 10rpx;
  display: inline-block;
}
