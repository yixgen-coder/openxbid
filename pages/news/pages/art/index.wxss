page {
  background: #FFFFFF;
}
.art-container {
  margin: 30rpx;
}
.art-container > view {
  margin-bottom: 30rpx;
}
.art-container .tit {
  font-weight: 600;
  font-size: 36rpx;
  color: #221F1C;
  text-align: center;
}
.art-container .store {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.art-container .store .logo {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.art-container .store .logo > image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
}
.art-container .store .logo > view > text {
  font-weight: bold;
  font-size: 28rpx;
  color: #666666;
}
.art-container .store .logo > view > view {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #999999;
}
.art-container .store .gz text {
  padding: 15rpx 40rpx;
  border-radius: 40rpx;
  font-weight: bold;
  font-size: 26rpx;
  color: #FFFFFF;
}
.art-container .store .gz .clolor1 {
  background: #bdbbbb;
}
.art-container .store .gz .clolor2 {
  background: #FF4A26;
}
.art-container .content {
  text-align: justify;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  line-height: 40rpx;
}
.art-container .content img {
  max-width: 100%;
  text-align: center;
}
.art-container .shengming {
  font-size: 22rpx;
  color: #A8A8A8;
}
.art-container .pl-tit {
  margin-top: 30rpx;
  font-weight: bold;
  font-size: 36rpx;
  color: #221F1C;
}
.art-container .pl {
  margin: 20rpx;
  background: #FFFFFF;
  margin-bottom: 180rpx;
}
.art-container .pl .circt-box {
  margin: 12rpx;
}
.art-container .pl .circt-box .circt-item {
  padding: 28rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid #E6E6E6;
}
.art-container .pl .circt-box .circt-item .top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.art-container .pl .circt-box .circt-item .top .left {
  font-size: 28rpx;
  color: #666666;
  display: flex;
  align-items: center;
}
.art-container .pl .circt-box .circt-item .top .left > image {
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  border-radius: 50%;
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}
.art-container .pl .circt-box .circt-item .top .right {
  font-size: 24rpx;
  color: #B3B3B3;
}
.art-container .pl .circt-box .circt-item .bottom {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #221F1C;
  text-align: justify;
}
.art-container .pl .circt-box .circt-item:last-child {
  border-bottom: none;
}
.msg {
  position: fixed;
  bottom: 0;
  width: 95%;
  padding: 20rpx;
  background-color: #FFFFFF;
  display: flex;
  gap: 30rpx;
  align-items: center;
}
.msg .wr {
  background-color: #F4F5F7;
  border-radius: 40rpx;
  height: 80rpx;
  padding-bottom: 0rpx;
  width: 60%;
}
.msg .wr .t-cell__title-text {
  margin-top: -10rpx;
  margin-left: -50rpx;
  font-size: 28rpx;
  color: #A8A8A8;
}
.msg .wr .t-icon__image {
  margin-top: 10rpx;
  width: 35rpx;
  height: 35rpx;
}
.block {
  width: 100vw;
  height: 240px;
  background: var(--td-bg-color-container);
  border-top-left-radius: 16rpx;
  border-top-right-radius: 16rpx;
}
.header {
  display: flex;
  align-items: center;
  height: 116rpx;
}
.title {
  flex: 1;
  text-align: center;
  font-weight: 600;
  font-size: 36rpx;
  color: var(--td-text-color-primary);
}
.btn {
  font-size: 32rpx;
  padding: 32rpx;
}
.btn--cancel {
  color: var(--td-text-color-secondary);
}
.btn--confirm {
  color: #0052d9;
}
.external-class {
  height: 324rpx;
}
.external-class .t-textarea__wrapper {
  background: #F4F5F7;
  padding: 10rpx;
}
