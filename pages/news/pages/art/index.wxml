<view class="art-container">
  <view class="tit">{{artInfo.title}}</view>
  <view class="store">
    <view class="logo">
      <image src="https://imgs.phanlink.com/{{artInfo.store.shop_logo}}"></image>
      <view>
        <text>{{artInfo.store.shop_name}}</text>
        <view>{{artInfo.ctime}}</view>
      </view>
    </view>
    <view class="gz" bindtap="storeClickHandle">
      <text wx:if="{{artInfo.gz==1}}" class="gz clolor2">已关注</text>
      <text wx:if="{{artInfo.gz==0}}" class="gz clolor1">关注</text>
    </view>
  </view>
  <view class="content">
    <rich-text nodes="{{artInfo.content}}"></rich-text>
  </view>
  <view class="shengming">该文观点仅代表作者本人，开拍鱼平台仅提供信息储存空间服务。</view>
  <view class="pl-tit">全部评论({{artInfo.pl}})</view>
  <view class="pl">
    <view class="circt-box">
      <view class="circt-item" wx:for="{{artInfo.pls}}">
        <view class="top">
          <view class="left">
            <image src="https://imgs.phanlink.com/{{item.avatar}}"></image>
            <text>{{item.nickname}}</text>
          </view>
          <view class="right">{{item.addtime}}</view>
        </view>
        <view class="bottom">{{item.msg}}</view>
      </view>
    </view>
  </view>
</view>
<view class="msg">
  <t-cell t-class="wr" title="填写资讯评论" align="center" left-icon="https://imgs.phanlink.com/program/images/wr.png" hover bordered="{{false}}" bindclick="handleShowMsg" />
  <t-icon name="thumb-up-2" size="48rpx" wx:if="{{artInfo.zan==0}}" bindclick="artZanClickHandle" />
  <t-icon name="thumb-up-2" size="48rpx" color="#FF4A26" wx:if="{{artInfo.zan==1}}" bindclick="artZanClickHandle" />
  <t-icon name="star" size="48rpx" wx:if="{{artInfo.sc==0}}" bindclick="artScClickHandle" />
  <t-icon name="star" size="48rpx" color="#FF4A26" wx:if="{{artInfo.sc==1}}" bindclick="artScClickHandle" />
  <t-button icon="https://imgs.phanlink.com/program/images/fx1.png" variant="text" size="large" open-type="share"></t-button>
</view>
<t-popup visible="{{visible}}" bind:visible-change="onVisibleChange" placement="bottom">
  <view class="block">
    <view class="header">
      <view class="btn btn--cancel" aria-role="button" bindtap="handleShowMsg">取消</view>
      <view class="title">资讯评论</view>
      <view class="btn btn--confirm" aria-role="button" bindtap="handleSubmit">确定</view>
    </view>
    <view class="msgtxt">
      <t-textarea bindchange="handleMsg" t-class="external-class" value="{{msg}}" placeholder="请输入内容" maxlength="100" disableDefaultPadding="{{true}}" indicator />
    </view>
  </view>
</t-popup>