.message-list-wrap {
  background: #FFFFFF;
  box-sizing: border-box;
  padding-top: 20rpx;
}
.message-list-wrap .cell-class {
  position: relative;
  padding: 15rpx 20rpx;
}
.message-list-wrap .cell-class-description {
  font-size: 26rpx;
  color: #A8A8A8;
}
.message-list-wrap .cell-image {
  border-radius: 50%;
}
.message-list-wrap .cell-note {
  position: absolute;
  right: 32rpx;
  top: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-end;
}
.message-list-wrap .cell-note .time {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 20rpx;
  margin-top: 22rpx;
}
.message-list-wrap .cell-note .wrapper1 {
  margin-right: 15rpx;
}
.message-list-wrap .border {
  background: #FFFFFF;
  height: 31rpx;
  position: relative;
}
.message-list-wrap .border::before {
  content: '';
  display: block;
  width: 686rpx;
  height: 1rpx;
  background-color: #E6E6E6;
  position: absolute;
  left: 32rpx;
  top: 10rpx;
}
