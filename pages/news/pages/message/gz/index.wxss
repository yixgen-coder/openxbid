page {
  background: #F7F8FA;
}
.goods-list {
  margin: 30rpx 20rpx;
}
.goods-list .items {
  margin: 20rpx 0;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}
.goods-list .items .gz {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 30rpx;
}
.goods-list .items .gz .st {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.goods-list .items .gz .st image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
}
.goods-list .items .gz .st > view text {
  font-weight: bold;
  font-size: 30rpx;
  color: #221F1C;
}
.goods-list .items .gz .st > view view {
  margin-top: 15rpx;
  font-size: 24rpx;
  color: #999999;
}
.goods-list .items .gz .zt {
  width: 30%;
  text-align: right;
}
.goods-list .items .gz .zt text {
  border-radius: 30rpx;
  border: 2rpx solid #FF5533;
  padding: 10rpx 20rpx;
  font-weight: bold;
  font-size: 28rpx;
  color: #F22800;
}
