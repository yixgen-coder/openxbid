<view class="order-group">
  <t-cell-group>
    <t-cell t-class="order-group__top" t-class-left="order-group__left" t-class-title="order-group__top__title" t-class-note="order-group__top__note" title="常用功能" bordered="{{true}}" bind:tap="onClickTop" />
  </t-cell-group>
  <view class="order-group__content">
    <view class="order-group__item" bindtap="onClickItem">
      <view class="order-group__item__icon icon-class">
        <t-icon name="https://imgs.phanlink.com/program/images/s1.png" size="52rpx" customStyle="background-image: -webkit-linear-gradient(90deg, #6a6a6a 0%,#929292 100%);-webkit-background-clip: text;-webkit-text-fill-color: transparent;" />
      </view>
      <view class="order-group__item__title title-class">商家名片</view>
    </view>
    <view class="order-group__item" bindtap="onClickItem">
      <view class="order-group__item__icon icon-class">
        <navigator url="/pages/my/pages/approve/index">
          <t-icon name="https://imgs.phanlink.com/program/images/s2.png" size="52rpx" customStyle="background-image: -webkit-linear-gradient(90deg, #6a6a6a 0%,#929292 100%);-webkit-background-clip: text;-webkit-text-fill-color: transparent;" />
        </navigator>
      </view>
      <view class="order-group__item__title title-class">商家认证</view>
    </view>

    <view class="order-group__item" bindtap="onClickItem">
      <view class="order-group__item__icon icon-class">

        <t-icon name="https://imgs.phanlink.com/program/images/s3.png" size="52rpx" customStyle="background-image: -webkit-linear-gradient(90deg, #6a6a6a 0%,#929292 100%);-webkit-background-clip: text;-webkit-text-fill-color: transparent;" />

      </view>
      <view class="order-group__item__title title-class">申请代采</view>
    </view>

    <view class="order-group__item" bindtap="onClickItem">
      <view class="order-group__item__icon icon-class">
        <t-icon name="https://imgs.phanlink.com/program/images/s8.png" size="52rpx" customStyle="background-image: -webkit-linear-gradient(90deg, #6a6a6a 0%,#929292 100%);-webkit-background-clip: text;-webkit-text-fill-color: transparent;" />
      </view>
      <view class="order-group__item__title title-class">我的粉丝</view>
    </view>
    <view class="order-group__item" bindtap="onClickItem">
      <view class="order-group__item__icon icon-class">
        <t-icon name="https://imgs.phanlink.com/program/images/s4.png" size="52rpx" customStyle="background-image: -webkit-linear-gradient(90deg, #6a6a6a 0%,#929292 100%);-webkit-background-clip: text;-webkit-text-fill-color: transparent;" />
      </view>
      <view class="order-group__item__title title-class">平台客服</view>
    </view>

    <view class="order-group__item" bindtap="onClickItem">
      <view class="order-group__item__icon icon-class">
        <t-icon name="https://imgs.phanlink.com/program/images/s5.png" size="52rpx" customStyle="background-image: -webkit-linear-gradient(90deg, #6a6a6a 0%,#929292 100%);-webkit-background-clip: text;-webkit-text-fill-color: transparent;" />
      </view>
      <view class="order-group__item__title title-class">关于平台</view>
    </view>
    <view class="order-group__item" bindtap="onClickItem">
      <view class="order-group__item__icon icon-class">
        <t-icon name="https://imgs.phanlink.com/program/images/s6.png" size="52rpx" customStyle="background-image: -webkit-linear-gradient(90deg, #6a6a6a 0%,#929292 100%);-webkit-background-clip: text;-webkit-text-fill-color: transparent;" />
      </view>
      <view class="order-group__item__title title-class">意见反馈</view>
    </view>
    <view class="order-group__item" bindtap="onClickItem">
      <view class="order-group__item__icon icon-class">
        <t-icon name="https://imgs.phanlink.com/program/images/s7.png" size="52rpx" customStyle="background-image: -webkit-linear-gradient(90deg, #6a6a6a 0%,#929292 100%);-webkit-background-clip: text;-webkit-text-fill-color: transparent;" />
      </view>
      <view class="order-group__item__title title-class">系统设置</view>
    </view>
  </view>
</view>