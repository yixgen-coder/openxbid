<view class="publish-wrap">
  <view class="publish-header" style="background:url('https://imgs.phanlink.com/program/images/loginbj.png') no-repeat top;background-size: cover;">
    <view class="bar-right" style="padding-top: {{statusbar}}px;height: {{jiaonangheight}}px;">
      <t-icon name="chevron-left" color="#221F1C" size="56rpx" bindtap="goback" />
    </view>
  </view>
  <view class="logo">
    <t-icon name="{{image}}" size="200rpx" data-name="{{image}}" />
    <view class="tit">{{globalLangData.openXbid}}</view>
  </view>
  <view class="login">
    <view class="wxlogin" wx:if="{{tabCurrent==0}}">
      <t-button wx:if="{{isDisabled}}" bindtap="getPhoneNumber1" theme="danger" size="large" t-class="phonebtn" block>{{globalLangData.phone_number_login}}</t-button>
      <t-button wx:if="{{!isDisabled}}" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber" theme="danger" size="large" t-class="phonebtn" block>{{globalLangData.phone_number_login}}</t-button>
    </view>
    <view class="login-form" wx:if="{{tabCurrent==1}}">
      <view class="tab-box">
        <t-tabs t-class="t-tabs" t-class-active="tabs-external__active" t-class-item="tabs-external__item" defaultValue="{{1}}" bind:change="tabChangeHandle">
          <t-tab-panel wx:for="{{tabList}}" wx:for-index="index" wx:key="index" label="{{item.text}}" value="{{item.key}}" />
        </t-tabs>
      </view>
      <view class="form-group" wx:if="{{tabIndex==1}}">
        <t-dropdown-menu>
          <t-dropdown-item options="{{product.options}}" placement="right" label="{{product.value}}" bindchange="onChange" />
        </t-dropdown-menu>
        <input type="number" placeholder="{{globalLangData.enter}} {{globalLangData.mobile_number}}" value="{{phoneNumber}}" bindinput="handlephoneNumber" class="phone-input" />
      </view>
      <view class="form-group" wx:if="{{tabIndex==2}}">
        <input placeholder="{{globalLangData.enter}} {{globalLangData.email}}" value="{{mailNumber}}" bindinput="handleMailNumber" class="phone-input" />
      </view>
      <view class="form-group">
        <input type="number" placeholder="{{globalLangData.enter}} {{globalLangData.verification_code}}" value="{{verificationCode}}" bindinput="handleverificationCode" class="code-input" />
        <button class="get-code-button" bindtap="getVerificationCode" disabled="{{sendcodestatus}}">{{getCodeButtonText}}</button>
      </view>
      <button class="submit-button" bindtap="submitForm">{{globalLangData.login}}</button>
      <button class="goback" bind:tap="tabcheck2">{{globalLangData.account_login}}</button>
      <button class="goback" bind:tap="tabcheck1">{{globalLangData.back_to_social_login}}</button>
    </view>
    <view class="login-form" wx:if="{{tabCurrent==2}}">
      <view class="tab-box">
        <t-tabs t-class="t-tabs" t-class-active="tabs-external__active" t-class-item="tabs-external__item" defaultValue="{{1}}" bind:change="tabChangeHandle">
          <t-tab-panel wx:for="{{tabList}}" wx:for-index="index" wx:key="index" label="{{item.text}}" value="{{item.key}}" />
        </t-tabs>
      </view>
      <view class="form-group" wx:if="{{tabIndex==1}}">
        <t-dropdown-menu>
          <t-dropdown-item options="{{product.options}}" placement="right" label="{{product.value}}" bindchange="onChange" />
        </t-dropdown-menu>
        <input type="number" placeholder="{{globalLangData.enter}} {{globalLangData.mobile_number}}" value="{{phoneNumber}}" bindinput="handlephoneNumber" class="phone-input" />
      </view>
      <view class="form-group" wx:if="{{tabIndex==2}}">
        <input placeholder="{{globalLangData.enter}} {{globalLangData.email}}" value="{{mailNumber}}" bindinput="handleMailNumber" class="phone-input" />
      </view>
      <view class="form-group">
        <input type="text" password="true" placeholder="{{globalLangData.enter}} {{globalLangData.password}}" value="{{password}}" bindinput="handlePassword" class="code-input" />
      </view>
      <button class="submit-button" bindtap="submitForm">{{globalLangData.login}}</button>
      <button class="goback" bind:tap="tabcheck">{{globalLangData.verification_login}}</button>
      <button class="goback" bind:tap="tabcheck1">{{globalLangData.back_to_social_login}}</button>
    </view>
  </view>
  <view class="loginxy">
    <radio-group>
      <label class="radio-label">
        <radio value="1" checked="{{checked}}" bindtap="checktap" />
        <span>{{globalLangData.privacy_policy}}</span>
      </label>
    </radio-group>
  </view>
  <view class="otherlogin" wx:if="{{tabCurrent==0}}">
    <view class="tit">
      <span></span>
      <text>{{globalLangData.other_login_methods}}</text>
      <span></span>
    </view>
    <view class="img" bind:tap="tabcheck2">
      <image src="https://imgs.phanlink.com/program/images/tel.png"></image>
    </view>
    <view class="txt">{{globalLangData.account_login}}</view>
  </view>
</view>