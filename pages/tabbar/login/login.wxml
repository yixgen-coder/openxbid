<view class="publish-wrap">
  <view class="publish-header" style="background:url('https://imgs.phanlink.com/program/images/loginbj.png') no-repeat top;background-size: cover;">
    <view class="bar-right" style="padding-top: {{statusbar}}px;height: {{jiaonangheight}}px;">
      <t-icon name="chevron-left" color="#221F1C" size="56rpx" />
    </view>
  </view>
  <view class="logo">
    <t-icon name="{{image}}" size="200rpx" data-name="{{image}}" />
    <view class="tit">开拍鱼</view>
  </view>
  <view class="login">
    <view class="wxlogin" wx:if="{{tabCurrent==0}}">
      <t-button open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber" disabled="{{isDisabled}}" theme="danger" size="large" t-class="phonebtn" block>手机号码一键登录</t-button>

    </view>
    <view class="login-form" wx:if="{{tabCurrent==1}}">
      <view class="form-group">
        <text>+86</text>
        <input type="number" placeholder="请输入手机号" value="{{phoneNumber}}" bindinput="handlephoneNumber" class="phone-input" />
      </view>
      <view class="form-group">
        <input type="number" placeholder="请输入验证码" value="{{verificationCode}}" bindinput="handleverificationCode" class="code-input" />
        <button class="get-code-button" bindtap="getVerificationCode" disabled="{{sendcodestatus}}">{{getCodeButtonText}}</button>
      </view>
      <button class="submit-button" bindtap="submitForm">登录</button>
      <button class="goback" bind:tap="tabcheck1">返回授权登录</button>
    </view>
  </view>
  <view class="loginxy">
    <radio-group>
      <label class="radio-label">
        <radio value="1" checked="{{checked}}" bindtap="checktap" />
        <span>我已阅读、理解并同意<text>《服务协议》</text>及<text>《隐私协议》</text></span>
      </label>
    </radio-group>
  </view>
  <view class="otherlogin" wx:if="{{tabCurrent==0}}">
    <view class="tit">
      <span></span>
      <text>其他登录方式</text>
      <span></span>
    </view>
    <view class="img" bind:tap="tabcheck">
      <image src="https://imgs.phanlink.com/program/images/tel.png"></image>
    </view>
    <view class="txt">验证码登录</view>
  </view>
</view>