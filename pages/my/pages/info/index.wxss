page {
  background-color: #F7F8FA;
  width: 100%;
}
.publish-wrap .publish-header {
  width: 100%;
  height: 180rpx;
  position: relative;
  overflow-x: hidden;
  box-sizing: border-box;
}
.publish-wrap .publish-header .bar-right {
  display: flex;
  padding-left: 34rpx;
  align-items: center;
}
.publish-wrap .publish-header .bar-right .avatar-text {
  display: block;
  width: 80%;
  font-size: 36rpx;
  color: #FFFFFF;
  text-align: center;
}
.avatar-wrapper {
  padding-top: 30rpx;
  background-color: #FFFFFF;
  margin-top: 30rpx;
}
.avatar-wrapper::after {
  border: none;
}
.avatar-wrapper .avatar {
  width: 200rpx;
  height: 200rpx;
}
.avatar-wrapper .avatar-text {
  display: block;
  font-size: 30rpx;
  color: #666666;
}
.renzh {
  font-size: 28rpx !important;
  color: #F22800 !important;
}
.tjbtn {
  margin: 40rpx 0rpx;
  position: fixed;
  bottom: 0;
  width: 100%;
}
.tjbtn button {
  width: 90%;
  background-color: #FF6426;
}
.popbox {
  height: 50vh;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0rpx 0rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  z-index: 100000;
}
.popbox .close {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 60rpx;
  height: 60rpx;
}
.popbox .title {
  color: #333333;
  font-size: 40rpx;
  font-weight: 600;
  padding: 40rpx;
}
.popbox .desc {
  color: #666666;
  font-size: 30rpx;
  padding: 20rpx 40rpx;
}
.popbox .t-input__label {
  color: #333333;
  font-size: 36rpx;
  font-weight: 600;
}
.popbox .avatar-wrapper {
  display: flex;
  align-items: center;
  gap: 80rpx;
  border-bottom: 1px solid #d1cfcf;
  padding-bottom: 30rpx;
  padding-top: 0rpx;
}
.popbox .avatar-wrapper .avatar-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}
.popbox .avatar-wrapper .avatar {
  border-radius: 80rpx;
  width: 120rpx;
  height: 120rpx;
}
.popbox .tjbtn {
  margin: 40rpx auto;
  position: relative;
  width: 80%;
}
