page {
  background: #F7F8FA;
}
.publish-wrap .publish-header {
  width: 100%;
  height: 180rpx;
  position: relative;
  overflow-x: hidden;
  box-sizing: border-box;
}
.publish-wrap .publish-header .bar-right {
  display: flex;
  padding-left: 34rpx;
  align-items: center;
}
.publish-wrap .publish-header .bar-right .avatar-text {
  display: block;
  width: 80%;
  font-size: 36rpx;
  color: #FFFFFF;
  text-align: center;
}
.publish-wrap .art-container {
  margin: 30rpx;
}
.publish-wrap .art-container > view {
  margin-bottom: 30rpx;
}
.publish-wrap .art-container .tit {
  font-weight: 600;
  font-size: 36rpx;
  color: #221F1C;
  text-align: center;
}
.publish-wrap .art-container .content {
  text-align: justify;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  line-height: 40rpx;
  width: 100%;
  overflow: hidden;
}
.publish-wrap .art-container .content img {
  max-width: 100%;
  text-align: center;
}
