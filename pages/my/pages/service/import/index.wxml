<view class="publish-wrap">
  <view class="publish-header" style="background:url('https://imgs.phanlink.com/program/images/bg.png') no-repeat top;background-size: cover;">
    <view class="bar-right" style="padding-top: {{statusbar}}px;height: {{jiaonangheight}}px;">
      <t-icon name="chevron-left" color="#FFFFFF" size="56rpx" bind:click="goback" />
      <text class="avatar-text">{{itemTitle}}</text>
    </view>
  </view>
  <view class="container">
    <!-- 搜索条件区域 -->
    <view class="search-section">
      <view class="search-bar">
        <input class="search-input" placeholder="输入关键词搜索" bindinput="onSearchInput" value="{{searchName}}" />
        <button class="search-btn" bindtap="onSearch">搜索</button>
      </view>
      <view class="expandable-text">
        <!-- 文本内容容器 -->
        <view id="textContainer" class="text-content {{isExpanded ? 'expanded' : 'collapsed'}}">
          备注：1、本数据汇集航运公司近期进口冻品数据，仅供参考，详细真实性请向有关部门核实。2、部分数据量太大而且集中度过高，不在此展示。如有需要请联系本平台。
        </view>

        <!-- 只有在文本过长时才显示按钮 -->
        <view wx:if="{{showButton}}" class="button" bindtap="toggleExpand">
          {{isExpanded ? '收起' : '显示全部'}}
        </view>
      </view>
    </view>

    <!-- 表格容器 -->
    <scroll-view class="table-container" scroll-x="{{true}}" scroll-y="{{true}}" bindscrolltolower="loadMoreData" scroll-with-animation="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <!-- 表格头部 -->
      <view class="table-head">
        <view class="table-row head-row">
          <view class="table-cell head-cell" wx:for="{{columns}}" wx:key="key">
            {{item.title}}
          </view>
        </view>
      </view>

      <!-- 表格内容 -->
      <view class="table-body">
        <view class="table-row body-row" wx:for="{{tableData}}">
          <view class="table-cell body-cell">
            {{item.original}}
          </view>
          <view class="table-cell body-cell">
            {{item.cdate}}
          </view>
          <view class="table-cell body-cell">
            {{item.pct}}
          </view>
          <view class="table-cell body-cell" bindtap="lookMore" data-title="{{item.info}}">
            {{item.info}}
          </view>
          <view class="table-cell body-cell" bindtap="lookMore" data-title="{{item.exporter}}">
            {{item.exporter}}
          </view>
          <view class="table-cell body-cell" bindtap="lookMore" data-title="{{item.importer}}">
            {{item.importer}}
          </view>
          <view class="table-cell body-cell">
            {{item.qty}}
          </view>
        </view>
      </view>
      <!-- 加载更多提示 -->
      <view class="load-more" wx:if="{{hasMore}}">
        <text class="loading-text"></text>
      </view>
      <view class="load-more" wx:else>
        <text class="no-more-text">已加载全部数据</text>
      </view>
    </scroll-view>
  </view>

</view>