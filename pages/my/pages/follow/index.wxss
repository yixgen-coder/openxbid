page {
  background: #F7F8FA;
}
.publish-wrap .publish-header {
  width: 100%;
  height: 180rpx;
  position: relative;
}
.publish-wrap .publish-header .bar-right {
  display: flex;
  padding-left: 34rpx;
  align-items: center;
}
.publish-wrap .publish-header .bar-right .avatar-text {
  display: block;
  width: 80%;
  font-size: 36rpx;
  color: #FFFFFF;
  text-align: center;
}
.home-page-container {
  background: #f5f5f5;
  display: block;
  padding: 0 0 30rpx 0;
  overflow: hidden;
}
.fish-list {
  padding: 24rpx;
  box-sizing: border-box;
}
