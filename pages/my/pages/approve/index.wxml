<view class="publish-wrap">
  <view class="publish-header" style="background:url('https://imgs.phanlink.com/program/images/color-bg.png') no-repeat top;background-size: cover;">
    <view class="bar-right" style="padding-top: {{statusbar}}px;height: {{jiaonangheight}}px;">
      <t-icon name="chevron-left" color="#221F1C" size="56rpx" bind:click="goback" />
    </view>
    <view class="title">
      <view class="text">
        {{globalLangData.select_verification_type}}
      </view>
    </view>
  </view>
  <view class="publish-content">
    <navigator url="/pages/my/pages/approve/auhor/index?items=2" class="cell-class">
      <t-cell t-class-title="cell-title" t-class-description="cell-description" t-class-right-icon="cell-icon" title="{{globalLangData.business_license_verification}}" description="{{globalLangData.start_verification}}" arrow />
    </navigator>
    <navigator url="/pages/my/pages/approve/auhor/index?items=1" class="cell-class">
      <t-cell t-class-title="cell-title" t-class-description="cell-description" t-class-right-icon="cell-icon" title="{{globalLangData.id_card_verification}}" description="{{globalLangData.start_verification}}" arrow />
    </navigator>
  </view>
</view>