page {
  background: #F7F8FA;
}
.publish-wrap .publish-header {
  width: 100%;
  height: 180rpx;
  position: relative;
}
.publish-wrap .publish-header .bar-right {
  display: flex;
  padding-left: 34rpx;
  align-items: center;
}
.publish-wrap .publish-header .bar-right .avatar-text {
  display: block;
  width: 80%;
  font-size: 36rpx;
  color: #FFFFFF;
  text-align: center;
}
.publish-wrap .rz {
  background: #FFFFFF;
  margin-top: 30rpx;
}
.publish-wrap .rz .tlabel {
  font-size: 32rpx;
  color: #221F1C;
  position: relative;
  padding-right: 20rpx;
}
.publish-wrap .rz .tlabel::after {
  content: '*';
  position: absolute;
  right: 0rpx;
  font-size: 32rpx;
  color: #F22800;
}
.publish-wrap .rz .t-icon--image {
  text-align: center;
}
.publish-wrap .rz .t-icon--image .t-icon__image {
  max-width: 25%;
}
.publish-wrap .tjbtn {
  margin: 50rpx 20rpx;
}
.publish-wrap .tjbtn button {
  background-color: #FF6426;
}
