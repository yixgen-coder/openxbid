<view class="publish-wrap">
  <view class="publish-header" style="background:url('https://imgs.phanlink.com/program/images/bg.png') no-repeat top;background-size: cover;">
    <view class="bar-right" style="padding-top: {{statusbar}}px;height: {{jiaonangheight}}px;">
      <t-icon name="chevron-left" color="#FFFFFF" size="56rpx" bind:click="goback" />
      <text class="avatar-text">{{itemTitle}}</text>
    </view>
  </view>
  <view class="rz">
    <form bindsubmit="onFormSubmit">
      <view wx:if="{{items==1}}">
        <t-input t-class-label="tlabel" label="姓名" value="{{grInfos.name}}" data-key="name" bindchange="handleGrInfos" placeholder="请输入您的姓名" align="right" />
        <t-cell title="请选择国家" arrow note="{{regionText}}" bind:click="onRegionPicker" required />
        <t-picker visible="{{regionVisible}}" value="{{regionValue}}" data-key="region" title="{{regionTitle}}" cancelBtn="取消" confirmBtn="确认" usingCustomNavbar bindchange="onPickerChange" bindpick="onColumnChange" bindcancel="onPickerCancel">
          <t-picker-item options="{{regions}}"></t-picker-item>
        </t-picker>
        <t-input t-class-label="tlabel" label="地区" value="{{grInfos.city}}" data-key="city" bindchange="handleGrInfos" placeholder="请输入您所在城市" align="right" />
        <t-input t-class-label="tlabel" label="手机号码" value="{{grInfos.mobile}}" data-key="mobile" bindchange="handleGrInfos" placeholder="请输入您的手机号码" align="right" />
        <t-input t-class-label="tlabel" label="邮箱" value="{{grInfos.mail}}" data-key="mail" bindchange="handleGrInfos" placeholder="请输入您的邮箱地址" align="right" />
        <t-cell title="请选择证件类型" arrow note="{{typeText}}" bind:click="onTitlePicker" required />
        <t-picker visible="{{typeVisible}}" value="{{typeValue}}" data-key="type" title="{{typeTitle}}" cancelBtn="取消" confirmBtn="确认" usingCustomNavbar bindchange="onPickerChange" bindpick="onColumnChange" bindcancel="onPickerCancel">
          <t-picker-item options="{{types}}"></t-picker-item>
        </t-picker>
        <t-input t-class-label="tlabel" label="{{typeText}}" value="{{grInfos.haom}}" data-key="haom" bindchange="handleGrInfos" placeholder="请输入您的{{typeText}}号码" align="right" />
        <t-cell title="请上传{{typeText}}证件" description="仅用于额度评估及身份认证，您的信息将严格加密保护" />
        <t-upload mediaType="{{['image']}}" max="{{1}}" files="{{fileList}}" bind:add="handleAdd" bind:remove="handleRemove" style="margin-top:40rpx;margin-left:20rpx;">
        </t-upload>
      </view>
      <view wx:if="{{items==2}}">
        <t-input t-class-label="tlabel" label="企业名称" value="{{qyInfos.companyname}}" data-key="companyname" bindchange="handleGrInfos" placeholder="请输入企业名称" align="right" />
        <t-input t-class-label="tlabel" label="社会信用代码" value="{{qyInfos.companyncode}}" data-key="companyncode" bindchange="handleGrInfos" placeholder="请输入社会信用代码" align="right" />
        <t-cell title="请选择国家" arrow note="{{regionText}}" bind:click="onRegionPicker" required />
        <t-picker visible="{{regionVisible}}" value="{{regionValue}}" data-key="region" title="{{regionTitle}}" cancelBtn="取消" confirmBtn="确认" usingCustomNavbar bindchange="onPickerChange" bindpick="onColumnChange" bindcancel="onPickerCancel">
          <t-picker-item options="{{regions}}"></t-picker-item>
        </t-picker>
        <t-input t-class-label="tlabel" label="地区" value="{{qyInfos.city}}" data-key="city" bindchange="handleGrInfos" placeholder="请输入您所在城市" align="right" />
        <t-input t-class-label="" label="海关备案号" value="{{qyInfos.hgcode}}" data-key="hgcode" bindchange="handleGrInfos" placeholder="请输入海关备案号" align="right" />
        <t-cell title="请上传营业执照" description="仅用于额度评估及身份认证，您的信息将严格加密保护" />
        <t-upload mediaType="{{['image']}}" max="{{1}}" files="{{fileList}}" bind:add="handleAdd" bind:remove="handleRemove" style="margin-top:40rpx;margin-left:20rpx;">
        </t-upload>
        <t-input t-class-label="" label="负责人" value="{{qyInfos.name}}" data-key="name" bindchange="handleGrInfos" placeholder="请输入负责人" align="right" />
        <t-input t-class-label="tlabel" label="手机号码" value="{{qyInfos.mobile}}" data-key="mobile" bindchange="handleGrInfos" placeholder="请输入您的手机号码" align="right" />
        <t-input t-class-label="tlabel" label="邮箱" value="{{qyInfos.mail}}" data-key="mail" bindchange="handleGrInfos" placeholder="请输入您的邮箱地址" align="right" />
      </view>
      <view class="tjbtn">
        <t-button disabled="{{btnStatus}}" theme="danger" size="large" type="submit" block>{{btnText}}</t-button>
      </view>
    </form>
  </view>
</view>