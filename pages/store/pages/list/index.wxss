page {
  background: #F7F8FA;
}
.publish-wrap .publish-header {
  width: 100%;
  height: 360rpx;
  position: relative;
  overflow-x: hidden;
  box-sizing: border-box;
}
.publish-wrap .publish-header .bar-right {
  display: flex;
  padding-left: 34rpx;
  align-items: center;
}
.publish-wrap .publish-header .bar-right .search {
  position: relative;
}
.publish-wrap .publish-header .bar-right .search .btn {
  width: 108rpx;
  height: 56rpx;
  background: linear-gradient(90deg, #FF7426 0%, #FF350D 100%);
  border-radius: 40rpx 40rpx 40rpx 40rpx;
  font-size: 24rpx;
  line-height: 56rpx;
  text-align: center;
  color: #ffffff;
  position: absolute;
  right: 5rpx;
  bottom: 5rpx;
  z-index: 9999;
}
.publish-wrap .publish-header .bar-right .search .t-search__input-container {
  border-radius: 32rpx !important;
  height: 64rpx !important;
  position: relative;
}
.publish-wrap .publish-header .bar-right .search .t-search__input {
  font-size: 28rpx !important;
  color: #747474 !important;
}
.publish-wrap .store-info {
  margin-top: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 20rpx;
}
.publish-wrap .store-info .logo {
  width: 100rpx;
}
.publish-wrap .store-info .logo image {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
}
.publish-wrap .store-info .info {
  width: 480rpx;
}
.publish-wrap .store-info .info .tit {
  font-weight: bold;
  font-size: 32rpx;
  color: #221F1C;
  margin-bottom: 20rpx;
}
.publish-wrap .store-info .info .tags {
  font-size: 24rpx;
  color: #666666;
}
.publish-wrap .store-info .info .tags text {
  margin-right: 15rpx;
}
.publish-wrap .store-info .info .tags text:first-child {
  color: #F22800;
}
.publish-wrap .store-info .info .tags text:last-child {
  color: #33AAFF;
}
.publish-wrap .store-info .gzbtn {
  width: 100rpx;
  padding: 10rpx 20rpx;
  background: linear-gradient(90deg, #FF6426 0%, #FF4A26 100%);
  border-radius: 32rpx;
  font-weight: bold;
  font-size: 28rpx;
  color: #FFFFFF;
  text-align: center;
}
.tab-box {
  background: #FFFFFF;
  --td-tab-nav-bg-color: #ffffff;
  --td-tab-item-color: #666666;
  --td-tab-track-color: #FF5533;
}
.tab-box .tabs-external__active {
  color: #333;
}
.fish-list {
  padding: 24rpx 10rpx;
  box-sizing: border-box;
}
