page {
  background: #F7F8FA;
  width: 100%;
}
.publish-wrap .publish-header {
  width: 100%;
  height: 180rpx;
  position: relative;
  overflow-x: hidden;
  box-sizing: border-box;
}
.publish-wrap .publish-header .bar-right {
  display: flex;
  padding-left: 34rpx;
  align-items: center;
}
.publish-wrap .publish-header .bar-right .avatar-text {
  display: block;
  width: 80%;
  font-size: 36rpx;
  color: #FFFFFF;
  text-align: center;
}
.publish-wrap .rz {
  background: #FFFFFF;
  margin-top: 30rpx;
  width: 100%;
  overflow: hidden;
}
.publish-wrap .rz .tlabel {
  font-size: 32rpx;
  color: #221F1C;
  position: relative;
  padding-right: 20rpx;
}
.publish-wrap .rz .tlabel::after {
  content: '*';
  position: absolute;
  right: 0rpx;
  font-size: 32rpx;
  color: #F22800;
}
.publish-wrap .rz .t-input__label:not(:empty) {
  min-width: var(--td-input-label-min-width, 11em);
}
.publish-wrap .rz .t-icon--image {
  text-align: center;
}
.publish-wrap .rz .t-icon--image .t-icon__image {
  max-width: 25%;
}
.publish-wrap .rz .logo {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.publish-wrap .rz .logo .t-upload {
  margin-right: 30rpx;
}
.publish-wrap .rz .logo .t-upload .t-grid-item {
  width: 100% !important;
}
.publish-wrap .rz .tnote {
  color: #F22800;
}
.publish-wrap .rz .intro {
  margin: 30rpx;
}
.publish-wrap .rz .intro text {
  display: block;
  padding-bottom: 20rpx;
  font-size: 32rpx;
  color: #221F1C;
}
.publish-wrap .rz .intro .external-class {
  height: 250rpx;
  background: #F7F8FA;
}
.publish-wrap .rz .tabpanel {
  font-size: 28rpx;
  margin: 30rpx;
}
.publish-wrap .rz .tabpanel .t-checkbox {
  min-width: 170rpx;
}
.publish-wrap .rz .block {
  width: 100vw;
  height: 600px;
  background: var(--td-bg-color-container);
  border-top-left-radius: 16rpx;
  border-top-right-radius: 16rpx;
}
.publish-wrap .rz .header {
  display: flex;
  align-items: center;
  height: 116rpx;
}
.publish-wrap .rz .title {
  flex: 1;
  text-align: center;
  font-weight: 600;
  font-size: 36rpx;
  color: var(--td-text-color-primary);
}
.publish-wrap .rz .btn {
  font-size: 32rpx;
  padding: 32rpx;
}
.publish-wrap .rz .btn--cancel {
  color: var(--td-text-color-secondary);
}
.publish-wrap .rz .btn--confirm {
  color: #0052d9;
}
.publish-wrap .tjbtn {
  margin: 50rpx 20rpx;
}
.publish-wrap .tjbtn button {
  background-color: #FF6426;
}
.publish-wrap .t-input__label:not(:empty) {
  min-width: var(--td-input-label-min-width, 4em);
  max-width: var(--td-input-label-max-width, 15em);
}
.publish-wrap .t-tab-panel {
  width: 95%;
}
.publish-wrap .t-checkbox__icon--left {
  margin-right: 0;
}
