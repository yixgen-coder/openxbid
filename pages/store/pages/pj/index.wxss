page {
  background: #F7F8FA;
}
.publish-wrap {
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 99999;
}
.publish-wrap .publish-header {
  width: 100%;
  height: 180rpx;
  position: relative;
  overflow-x: hidden;
  box-sizing: border-box;
}
.publish-wrap .publish-header .bar-right {
  display: flex;
  padding-left: 34rpx;
  align-items: center;
}
.publish-wrap .publish-header .bar-right .avatar-text {
  display: block;
  width: 80%;
  font-size: 36rpx;
  color: #FFFFFF;
  text-align: center;
}
.home-page-container .gl {
  margin: 20rpx 0;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.home-page-container .gl text:first-child {
  font-weight: 500;
  font-size: 28rpx;
  color: #999999;
}
.home-page-container .gl text:last-child {
  font-weight: bold;
  font-size: 28rpx;
  color: #221F1C;
}
.home-page-container .pj-list {
  margin: 0 20rpx;
}
.home-page-container .pj-list .items {
  background-color: #FFFFFF;
  padding: 30rpx 20rpx;
  margin: 20rpx 0;
  border-radius: 10rpx;
}
.home-page-container .pj-list .items .usr {
  display: flex;
  justify-content: space-between;
}
.home-page-container .pj-list .items .usr .dat {
  display: flex;
  gap: 20rpx;
}
.home-page-container .pj-list .items .usr .dat image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
}
.home-page-container .pj-list .items .usr .dat .tit text {
  display: block;
  font-weight: bold;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 10rpx;
}
.home-page-container .pj-list .items .usr .date {
  font-size: 24rpx;
  color: #999999;
}
.home-page-container .pj-list .items .cont {
  font-size: 28rpx;
  color: #221F1C;
  margin: 20rpx 0;
}
.home-page-container .pj-list .items .goods {
  display: flex;
  gap: 20rpx;
  margin: 30rpx 0;
}
.home-page-container .pj-list .items .goods image {
  width: 90rpx;
  height: 90rpx;
}
.home-page-container .pj-list .items .goods .tit text {
  font-weight: bold;
  font-size: 28rpx;
  color: #221F1C;
}
.home-page-container .pj-list .items .goods .tit .tags {
  margin-top: 15rpx;
}
.home-page-container .pj-list .items .goods .tit .tags text {
  font-size: 22rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}
.home-page-container .pj-list .items .goods .tit .tags text:first-child {
  color: #FF5533;
  background: #FFF4F2;
}
.home-page-container .pj-list .items .goods .tit .tags text:nth-child(2) {
  color: #33AAFF;
  background: #EBF7FF;
}
.home-page-container .pj-list .items .goods .tit .tags text:last-child {
  color: #979797;
  background: #F7F8FA;
}
.home-page-container .pj-list .items .reply {
  margin: 20rpx 0;
}
.home-page-container .pj-list .items .reply text {
  font-weight: bold;
  font-size: 28rpx;
  color: #666666;
}
.home-page-container .pj-list .items .btn {
  padding-top: 30rpx;
  border-top: 1rpx solid #E6E6E6;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}
.home-page-container .pj-list .items .btn button {
  margin: 0;
  font-weight: bold;
  font-size: 24rpx;
}
.home-page-container .pj-list .items .btn button:after {
  border: none;
}
.home-page-container .pj-list .items .btn button:first-child {
  background: #F4F5F7;
  border-radius: 32rpx;
  color: #645050;
}
.home-page-container .pj-list .items .btn button:last-child {
  background: #FFF4F2;
  border-radius: 32rpx;
  color: #FF5533;
}
.tab-box {
  margin-top: 180rpx;
  --td-tab-nav-bg-color: #ffffff;
  --td-tab-item-color: #181717;
  --td-tab-track-color: #FF5533;
  --td-tab-track-width: 60rpx;
}
.tab-box .tabs-external__active {
  color: #333;
}
.block {
  width: 100vw;
  height: 240px;
  background: var(--td-bg-color-container);
  border-top-left-radius: 16rpx;
  border-top-right-radius: 16rpx;
}
.block .header {
  display: flex;
  align-items: center;
  height: 116rpx;
}
.block .title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  color: var(--td-text-color-primary);
}
.block .btn {
  font-size: 32rpx;
  padding: 32rpx;
}
.block .btn--cancel {
  color: var(--td-text-color-secondary);
}
.block .btn--confirm {
  color: #0052d9;
}
.block .external-class {
  height: 324rpx;
}
.block .external-class .t-textarea__wrapper {
  background: #F4F5F7;
  padding: 10rpx;
}
