<view style="text-align: center; color: #b9b9b9" wx:if="{{pageLoading}}">
  <t-loading theme="circular" size="40rpx" text="加载中..." inherit-color />
</view>
<view class="publish-wrap">
  <view class="publish-header" style="background:url('https://imgs.phanlink.com/program/images/bg.png') no-repeat top;background-size: cover;">
    <view class="bar-right" style="padding-top: {{statusbar}}px;height: {{jiaonangheight}}px;">
      <t-icon name="chevron-left" color="#FFFFFF" size="56rpx" bindtap="goback" />
      <text class="avatar-text">{{itemTitle}}</text>
    </view>
  </view>
</view>
<!-- tab区域 -->
<view class="tab-box" wx:if="{{jd==0}}">
  <t-tabs t-class="t-tabs" t-class-active="tabs-external__active" t-class-item="tabs-external__item" defaultValue="{{tabIndex}}" bind:change="tabChangeHandle">
    <t-tab-panel wx:for="{{tabList}}" wx:for-index="index" wx:key="index" label="{{item.text}}" value="{{item.key}}" />
  </t-tabs>
</view>
<view class="home-page-container">
  <view class="gl">
    <text>{{globalLangData.lang==1?'Total':'共'}}{{scount}}{{globalLangData.lang==1?'items':'条'}}</text>
    <text>{{globalLangData.dashboard}}</text>
  </view>
  <view class="pj-list">
    <view class="items" wx:for="{{goodsList}}">

      <navigator class="goods" url="/pages/goods/pages/index/index?spuId={{item.goods_id}}">
        <image src="{{item.pic}}"></image>
        <view class="tit">
          <text>{{item.title}}</text>
          <view class="tags">
            <text>{{item.btype}}</text>
            <text>{{item.nature}}</text>
            <text>{{item.place}}</text>
          </view>
        </view>
      </navigator>
      <view class="usr">
        <view class="dat">
          <image src="{{item.avatar}}"></image>
          <view class="tit">
            <text>{{item.nickname}}</text>
            <t-rate value="{{item.score}}" color="#FF5959" gap="0" size="30rpx" allow-half="{{true}}" showText="{{false}}" />
          </view>
        </view>
        <view class="date">{{item.addtime}}</view>
      </view>
      <view class="cont">{{item.msg}}</view>

      <view class="reply" wx:if="{{tabIndex==2}}">
        <text>{{globalLangData.my_reply}}：</text>
        <text>{{item.reply}}</text>
      </view>
      <view class="btn">
        <button data-id="{{item.id}}" wx:if="{{tabIndex==2}}" bindtap="pjClickHandle">{{globalLangData.delete}} {{globalLangData.reviews}}</button>
        <button bindtap="handleShowPj" data-id="{{item.id}}" data-index="{{index}}">{{item.status?globalLangData.modify_reply:globalLangData.reply}}</button>
      </view>
    </view>
  </view>
  <load-more list-is-empty="{{!goodsList.length}}" status="{{loadStatus}}" bind:retry="onReTry" />
</view>
<!-- 评价 -->
<t-popup visible="{{pjvisible}}" placement="bottom" style="bottom:{{keyboardheight}}rpx">
  <view class="block">
    <view class="header">
      <view class="btn btn--cancel" aria-role="button" bindtap="handleShowPj">{{globalLangData.cancel}}</view>
      <view class="title">{{globalLangData.comment_reply}}</view>
      <view class="btn btn--confirm" aria-role="button" bindtap="handleSubmit">{{globalLangData.sure}}</view>
    </view>
    <view class="msgtxt">
      <t-textarea bindchange="handleReply" value="{{pjReply}}" bindkeyboardheightchange="handlekeyboardheight" t-class="external-class" placeholder="{{globalLangData.enter}}" maxlength="100" show-confirm-bar="{{false}}" disableDefaultPadding="{{true}}" indicator />
    </view>
  </view>
</t-popup>