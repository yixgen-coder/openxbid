page {
  background: #F7F8FA;
  padding-bottom: 120rpx;
}
.classify-header {
  height: 750rpx;
  width: 750rpx;
  position: relative;
  background-color: #fff;
}
.classify-header .top-bar {
  position: absolute;
  top: 0;
  left: 0;
  width: 500rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 24rpx;
  z-index: 1;
}
.classify-header .top-bar > image {
  width: 68rpx;
  height: 68rpx;
}
.classify-header .t-swiper image {
  height: 750rpx;
  width: 750rpx;
}
.classify-header .t-swiper .t-swiper-nav {
  bottom: 140rpx;
}
.classify-header .count-down {
  position: absolute;
  width: 100%;
  bottom: 0;
  left: 0;
  height: 100rpx;
  width: 750rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  color: #fff;
  box-sizing: border-box;
  font-size: 34rpx;
}
.classify-header .count-down .right {
  display: flex;
  align-items: center;
}
.classify-header .count-down .right .time-text {
  font-size: 28rpx;
  margin-right: 15rpx;
}
.classify-header .count-down .right .count-down-class {
  --td-countdown-bg-color: #fff;
  --td-countdown-round-color: #FF5F23;
}
.classify-header .count-down .right .count-down-class1 {
  --td-countdown-bg-color: #fff;
  --td-countdown-round-color: #28C667;
}
.classify-header .count-down .right .class-split {
  color: #fff;
}
.newPra {
  margin: 30rpx 0;
  padding: 20rpx 0;
  background: #F7F8FA;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-around;
  text-align: center;
  align-items: flex-end;
}
.newPra .item .txt1 {
  font-weight: bold;
  font-size: 28rpx;
  color: #221F1C;
}
.newPra .item .txt2 {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8B8A90;
}
.newPra .item1 {
  width: 0rpx;
  height: 40rpx;
  border-radius: 0rpx 0rpx 0rpx 0rpx;
  border: 2rpx solid #E6E6E6;
}
.classify-box {
  background-color: #fff;
  padding: 32rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}
.classify-box .title {
  font-weight: bold;
  font-size: 34rpx;
  color: #221F1C;
  margin-bottom: 20rpx;
}
.classify-box .tags .margin-right-12 {
  margin-right: 12rpx;
  color: #FFFFFF !important;
  background: #FF5533;
}
.classify-box .tags .tag-class {
  --td-tag-default-font-color: #979797;
}
.classify-box .price {
  margin-top: 42rpx;
  margin-bottom: 42rpx;
  padding-bottom: 36rpx;
  display: flex;
  justify-content: space-between;
  font-weight: bold;
  font-size: 28rpx;
  border-bottom: 1rpx solid #EDEDED;
}
.classify-box .price .red {
  color: #F22800;
}
.classify-box .price .big {
  font-size: 36rpx;
}
.classify-box .viewpoit {
  font-size: 26rpx;
  color: #979797;
  display: flex;
  justify-content: space-between;
}
.classify-box .viewpoit text {
  color: #666666;
  margin-right: 32rpx;
}
.classify-box .margin-b-35 {
  margin-bottom: 35rpx;
}
.classify-box .fixed {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #221F1C;
}
.classify-box .fixed .gray {
  color: #666666;
}
.classify-box .fixed .has-icon {
  display: flex;
  align-items: center;
}
.classify-box .circt-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.classify-box .circt-title .left {
  font-size: 32rpx;
  color: #221F1C;
  font-weight: 800;
}
.classify-box .circt-title .left text {
  font-weight: normal;
}
.classify-box .circt-title .right {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #A8A8A8;
}
.classify-box .circt-box {
  margin-top: 12rpx;
}
.classify-box .circt-box .circt-item {
  padding: 28rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid #E6E6E6;
}
.classify-box .circt-box .circt-item .top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.classify-box .circt-box .circt-item .top .left {
  font-size: 28rpx;
  color: #666666;
  display: flex;
  align-items: center;
}
.classify-box .circt-box .circt-item .top .left > image {
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  border-radius: 50%;
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}
.classify-box .circt-box .circt-item .top .right {
  font-size: 24rpx;
  color: #B3B3B3;
}
.classify-box .circt-box .circt-item .bottom {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #221F1C;
  text-align: justify;
}
.classify-box .circt-box .circt-item:last-child {
  border-bottom: none;
}
.box-fixed {
  display: flex;
  align-items: center;
}
.box-fixed .compiny-image {
  width: 100%;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.box-fixed .compiny-right .compiny-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 558rpx;
}
.box-fixed .compiny-right .compiny-title .title-text {
  font-weight: bold;
  font-size: 32rpx;
  color: #221F1C;
}
.box-fixed .compiny-right .compiny-title .title-btn {
  width: 116rpx;
  height: 44rpx;
  border-radius: 24rpx 24rpx 24rpx 24rpx;
  border: 1rpx solid #FF5959;
  display: inline-block;
  font-size: 22rpx;
  color: #FF5959;
  line-height: 44rpx;
  text-align: center;
}
.box-fixed .compiny-right .rate {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666666;
  margin-top: 20rpx;
}
.box-fixed .compiny-right .rate .red {
  color: #F22800;
  margin-left: 6rpx;
}
.tab-box {
  background-color: #fff;
}
.tab-box .tab-class-active {
  color: #221F1C;
}
.tab-box .t-class-track {
  width: 100rpx;
  background-color: #FF5533;
}
.tab-box .t-tabs__item-inner {
  font-size: 32rpx;
  color: #000000;
}
.footer-box {
  position: fixed;
  width: 100%;
  bottom: 0;
  left: 0;
  height: 120rpx;
  border-top: 1rpx solid #E6E6E6;
  padding-bottom: 82rpx;
  padding-right: 36rpx;
  padding-left: 10rpx;
  padding-top: 20rpx;
  background-color: #fff;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  z-index: 9999;
}
.footer-box .user-txt {
  width: 230rpx;
}
.footer-box .user-txt > navigator {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.footer-box .user-txt > navigator > image {
  display: block;
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
}
.footer-box .img-txt {
  text-align: center;
}
.footer-box .img-txt > image {
  display: block;
  width: 40rpx;
  height: 40rpx;
  margin: 0 auto;
}
.footer-box .img-txt > view {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #666666;
  margin-top: 5rpx;
}
.footer-box .btn {
  width: 300rpx;
  height: 80rpx;
  border-radius: 40rpx;
  line-height: 80rpx;
  text-align: center;
  color: #fff;
  background: linear-gradient(to right, #FF6426, #FF4A26);
}
.footer-box .btn1 {
  width: 300rpx;
  height: 80rpx;
  border-radius: 40rpx;
  line-height: 80rpx;
  text-align: center;
  color: #fff;
  background: linear-gradient(to right, #26BF63, #26BF63);
}
.footer-box .btn2 {
  width: 300rpx;
  height: 80rpx;
  border-radius: 40rpx;
  line-height: 80rpx;
  text-align: center;
  color: #fff;
  background: linear-gradient(to right, #979797, #979797);
}
.share {
  display: flex;
  width: 100%;
  justify-content: space-around;
  padding-top: 56rpx;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid #E6E6E6;
}
.share .share-item {
  background-color: transparent;
}
.share .share-item::after {
  border: none;
}
.share .share-item > image {
  display: block;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
}
.share .share-item > view {
  font-size: 30rpx;
  color: #221F1C;
}
.qx {
  text-align: center;
  padding-top: 34rpx;
  font-size: 32rpx;
  color: #999999;
}
