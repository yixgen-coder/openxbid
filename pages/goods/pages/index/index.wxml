<view class="classify-header">
  <view class="top-bar" style="padding-top:{{statusbar}}px;height: {{jiaonangheight}}px;">
    <image src="https://imgs.phanlink.com/program/images/left{{currentPage}}.png" bindtap="goback"></image>
    <image bind:tap="handleShareShow" src="https://imgs.phanlink.com/program/images/sher.png"></image>
  </view>
  <!-- <image src="https://imgs.phanlink.com/program/images/topbg.png"></image> -->
  <t-swiper current="{{current}}" bindclick="previewImage" autoplay="{{autoplay}}" duration="{{duration}}" interval="{{interval}}" list="{{goodsInfo.pics}}" navigation="{{ { type: 'fraction' } }}" paginationPosition="{{paginationPosition}}" height="750rpx" />
  <view wx:if="{{hideMydata && goodsInfo.statu==2}}" class="count-down" style="background: url('https://imgs.phanlink.com/program/images/sm.png') no-repeat bottom;background-size: cover;">
    <view>{{globalLangData.bidding1}}</view>
    <view class="right"><text class="time-text">{{globalLangData.closes_in}}</text>
      <view class="demo-count-down-content">
        <t-count-down bindfinish="handleFinish" t-class="count-down-class" t-class-split="class-split" content="default" time="{{goodsInfo.time}}" format="DD:HH:mm:ss" splitWithUnit="{{globalLangData.lang==2?true:false}}" theme="square"> </t-count-down>
      </view>
    </view>
  </view>
  <view wx:if="{{hideMydata && goodsInfo.statu==1}}" class="count-down" style="background: url('https://imgs.phanlink.com/program/images/sm1.png') no-repeat bottom;background-size: cover;">
    <view>{{globalLangData.notstarted}}</view>
    <view class="right"><text class="time-text">{{globalLangData.start_in}}</text>
      <view class="demo-count-down-content">
        <t-count-down t-class="count-down-class1" t-class-split="class-split" content="default" time="{{goodsInfo.time}}" format="DD-HH:mm:ss" splitWithUnit="{{globalLangData.lang==2?true:false}}" theme="square"> </t-count-down>
      </view>
    </view>
  </view>
  <view wx:if="{{hideMydata &&  goodsInfo.statu==3}}" class="count-down" style="background: url('https://imgs.phanlink.com/program/images/sm2.png') no-repeat bottom;background-size: cover;">
    <view>{{globalLangData.bidding_closed}}</view>
    <view class="right"><text class="time-text">{{globalLangData.ends}}：{{goodsInfo.etime}}</text>
    </view>
  </view>
</view>
<!-- 标题信息 -->
<view class="classify-box">
  <view class="title">
    <t-tag wx:if="{{goodsInfo.btype==1}}" variant="light" theme="warning" style="margin-right:10rpx;">{{globalLangData.sell}}</t-tag>
    <t-tag wx:if="{{goodsInfo.btype==2}}" variant="light" theme="success" style="margin-right:10rpx;">{{globalLangData.buy}}</t-tag>
    {{goodsInfo.title}}
  </view>
  <view class="tags">
    <t-tag class="margin-right-12" wx:if="{{goodsInfo.btype==2&&goodsInfo.dc==1}}" variant="light">{{goodsInfo.accept_proxy_procurement}}</t-tag>
    <t-tag wx:if="{{goodsInfo.nature !== null}}" class="margin-right-12" t-class="tag-class" variant="light">{{goodsInfo.nature}}</t-tag>
    <t-tag wx:if="{{goodsInfo.place !== null}}" class="margin-right-12" t-class="tag-class" variant="light">{{goodsInfo.place}}</t-tag>
    <t-tag wx:if="{{goodsInfo.manufacturer !== null}}" class="margin-right-12" t-class="tag-class" variant="light">{{goodsInfo.manufacturer}}</t-tag>
  </view>
  <view class="newPra">
    <view class="item">
      <view class="txt1">{{goodsInfo.weight}}KG</view>
      <view class="txt2">{{globalLangData.weight}}</view>
    </view>
    <view class="item1"></view>
    <view class="item">
      <view class="txt1">{{goodsInfo.bourn}}</view>
      <view class="txt2">{{globalLangData.location}}</view>
    </view>
    <view class="item1"></view>
    <view class="item">
      <view class="txt1">{{goodsInfo.ptime}}</view>
      <view class="txt2">{{globalLangData.production_date}}</view>
    </view>
  </view>
  <view class="price">
    <view>{{globalLangData.current}}:<text class="red">{{goodsInfo.currencyType==1?'$':'￥'}}</text><text class="red big">{{goodsInfo.current_price?goodsInfo.current_price:goodsInfo.pric}}</text></view>
    <view style="display: flex;align-items: center;" bindtap="handleGoOffer">
      <text class="red big">{{globalLangData.biding_detail}} </text>
      <t-icon name="chevron-right" color="#FF5533" size="48rpx" />
    </view>
  </view>
  <view class="viewpoit" wx:if="{{hideMydata}}"> <text>{{globalLangData.watching}} {{goodsInfo.hits}} 人</text>
    <text>{{globalLangData.bid}} {{goodsInfo.apply}} 次</text>
  </view>
</view>
