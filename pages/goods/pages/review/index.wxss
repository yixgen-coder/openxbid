page {
  background: #F7F8FA;
}
page .review {
  margin: 20rpx;
  background: #FFFFFF;
}
page .review .circt-box {
  margin: 12rpx;
}
page .review .circt-box .circt-item {
  padding: 28rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid #E6E6E6;
}
page .review .circt-box .circt-item .top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
page .review .circt-box .circt-item .top .left {
  font-size: 28rpx;
  color: #666666;
  display: flex;
  align-items: center;
}
page .review .circt-box .circt-item .top .left > image {
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  border-radius: 50%;
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}
page .review .circt-box .circt-item .top .right {
  font-size: 24rpx;
  color: #B3B3B3;
}
page .review .circt-box .circt-item .bottom {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #221F1C;
  text-align: justify;
}
page .review .circt-box .circt-item:last-child {
  border-bottom: none;
}
page .msg {
  position: fixed;
  bottom: 0;
  width: 95%;
  padding: 20rpx;
  background-color: #FFFFFF;
}
page .msg .wr {
  background-color: #F4F5F7;
  border-radius: 40rpx;
  height: 80rpx;
  padding-bottom: 0rpx;
}
page .msg .wr .t-cell__title-text {
  margin-top: -10rpx;
  margin-left: -50rpx;
  font-size: 28rpx;
  color: #A8A8A8;
}
page .msg .wr .t-icon__image {
  margin-top: 10rpx;
  width: 35rpx;
  height: 35rpx;
}
.block {
  width: 100vw;
  height: 240px;
  background: var(--td-bg-color-container);
  border-top-left-radius: 16rpx;
  border-top-right-radius: 16rpx;
}
.header {
  display: flex;
  align-items: center;
  height: 116rpx;
}
.title {
  flex: 1;
  text-align: center;
  font-weight: 600;
  font-size: 36rpx;
  color: var(--td-text-color-primary);
}
.btn {
  font-size: 32rpx;
  padding: 32rpx;
}
.btn--cancel {
  color: var(--td-text-color-secondary);
}
.btn--confirm {
  color: #0052d9;
}
.external-class {
  height: 324rpx;
}
.external-class .t-textarea__wrapper {
  background: #F4F5F7;
  padding: 10rpx;
}
