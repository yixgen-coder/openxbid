page {
  background: #F7F8FA;
}
.publish-wrap .publish-header {
  width: 100%;
  height: 180rpx;
  position: relative;
  overflow-x: hidden;
  box-sizing: border-box;
}
.publish-wrap .publish-header .bar-right {
  display: flex;
  padding-left: 34rpx;
  align-items: center;
}
.publish-wrap .publish-header .bar-right .avatar-text {
  display: block;
  width: 80%;
  font-size: 36rpx;
  color: #FFFFFF;
  text-align: center;
}
.home-page-container {
  background: #f5f5f5;
  display: block;
  padding: 0 0 30rpx 0;
  overflow: hidden;
}
.tab-box {
  --td-tab-nav-bg-color: #ffffff;
  --td-tab-item-color: #A8A8A8;
  --td-tab-track-color: #FFFFFF;
  --td-tab-track-width: 60rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 750rpx;
}
.tab-box .t-tabs {
  width: 500rpx;
  font-size: 30rpx;
}
.tab-box .gl {
  margin-right: 30rpx;
  font-weight: bold;
  font-size: 32rpx;
  color: #221F1C;
  letter-spacing: 2rpx;
}
.tab-box .tabs-external__active {
  color: #FF5533;
}
.goodslist {
  background: #FFFFFF;
  padding: 30rpx 20rpx;
  border-radius: 24rpx;
  margin-bottom: 30rpx;
}
.goodslist .tit {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #E6E6E6;
}
.goodslist .tit .color1 {
  color: #141311;
}
.goodslist .tit .color2 {
  font-weight: bold;
  color: #F22800;
}
.goodslist .tit .color3 {
  font-weight: bold;
  color: #A8A8A8;
}
.goodslist .goodsInfo {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #E6E6E6;
}
.goodslist .goodsInfo image {
  width: 140rpx;
  height: 140rpx;
}
.goodslist .goodsInfo .info {
  width: 500rpx;
}
.goodslist .goodsInfo .info > text {
  font-weight: bold;
  font-size: 30rpx;
  color: #221F1C;
}
.goodslist .goodsInfo .info .tags {
  margin: 15rpx 0;
}
.goodslist .goodsInfo .info .tags text {
  padding: 10rpx 20rpx;
  margin-right: 15rpx;
  background: #F7F8FA;
  border-radius: 4rpx;
  font-size: 24rpx;
  color: #979797;
}
.goodslist .goodsInfo .info .price {
  font-weight: 600;
  font-size: 26rpx;
  color: #221F1C;
}
.goodslist .cz {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 30rpx;
}
.goodslist .cz text {
  font-size: 24rpx;
  color: #999999;
}
.goodslist .cz .btn {
  font-size: 24rpx;
}
.goodslist .cz .btn span {
  padding: 15rpx 20rpx;
  border-radius: 32rpx;
  margin: 0 5rpx;
}
.goodslist .cz .btn span:nth-child(1) {
  background: #F4F5F7;
  color: #666666;
}
.goodslist .cz .btn span:nth-child(2) {
  background: #FFF4F2;
  color: #FF5533;
}
.goodslist .cz .btn span:nth-child(3) {
  background: #f7eae7;
  color: #eb0808;
}
.fish-list {
  padding: 24rpx;
  box-sizing: border-box;
}
