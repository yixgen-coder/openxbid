page {
  background: #F7F8FA;
}
.publish-wrap .publish-header {
  width: 100%;
  height: 290rpx;
  position: relative;
}
.publish-wrap .publish-header .bar-right {
  display: flex;
  padding-left: 34rpx;
  align-items: center;
}
.publish-wrap .publish-header .bar-right .avatar-text {
  display: block;
  width: 80%;
  font-size: 36rpx;
  color: #FFFFFF;
  text-align: center;
}
.publish-wrap .publish-header .search {
  margin: 30rpx 20rpx 0 20rpx;
  position: relative;
}
.publish-wrap .publish-header .search .btn {
  width: 108rpx;
  height: 56rpx;
  background: linear-gradient(90deg, #FF7426 0%, #FF350D 100%);
  border-radius: 40rpx 40rpx 40rpx 40rpx;
  font-size: 24rpx;
  line-height: 56rpx;
  text-align: center;
  color: #ffffff;
  position: absolute;
  right: 5rpx;
  bottom: 5rpx;
  z-index: 9999;
}
.publish-wrap .publish-header .search .t-search__input-container {
  border-radius: 32rpx !important;
  height: 64rpx !important;
  position: relative;
}
.publish-wrap .publish-header .search .t-search__input {
  font-size: 28rpx !important;
  color: #747474 !important;
}
.tab-box {
  --td-tab-nav-bg-color: #ffffff;
  --td-tab-item-color: #666666;
  --td-tab-track-color: #FF5533;
  --td-tab-track-width: 60rpx;
}
.tab-box .tabs-external__active {
  color: #333;
}
.fish-list {
  padding: 24rpx;
  box-sizing: border-box;
}
