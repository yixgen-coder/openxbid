page {
  background: #F7F8FA;
}
.classify-header {
  height: 750rpx;
  width: 750rpx;
  position: relative;
  background-color: #fff;
}
.classify-header > image {
  height: 750rpx;
  width: 750rpx;
}
.classify-header .count-down {
  position: absolute;
  width: 100%;
  bottom: 0;
  left: 0;
  height: 100rpx;
  width: 750rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  color: #fff;
  box-sizing: border-box;
  font-size: 34rpx;
}
.classify-header .count-down .right {
  display: flex;
  align-items: center;
}
.classify-header .count-down .right .time-text {
  font-size: 28rpx;
  margin-right: 15rpx;
}
.classify-header .count-down .right .count-down-class {
  --td-countdown-bg-color: #fff;
  --td-countdown-round-color: #FF5F23;
}
.classify-header .count-down .right .class-split {
  color: #fff;
}
.classify-box {
  background-color: #fff;
  padding: 32rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}
.classify-box .title {
  font-weight: bold;
  font-size: 34rpx;
  color: #221F1C;
  margin-bottom: 20rpx;
}
.classify-box .tags .margin-right-12 {
  margin-right: 12rpx;
}
.classify-box .tags .tag-class {
  --td-tag-default-font-color: #979797;
}
.classify-box .price {
  margin-top: 42rpx;
  margin-bottom: 36rpx;
  display: flex;
  justify-content: space-between;
  font-weight: bold;
  font-size: 24rpx;
}
.classify-box .price .red {
  color: #F22800;
}
.classify-box .price .big {
  font-size: 36rpx;
}
.classify-box .viewpoit {
  font-size: 26rpx;
  color: #979797;
}
.classify-box .viewpoit text {
  color: #666666;
  margin-right: 32rpx;
}
.classify-box .margin-b-35 {
  margin-bottom: 35rpx;
}
.classify-box .fixed {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #221F1C;
}
.classify-box .fixed .gray {
  color: #666666;
}
.classify-box .fixed .has-icon {
  display: flex;
  align-items: center;
}
.classify-box .circt-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.classify-box .circt-title .left {
  font-size: 32rpx;
  color: #221F1C;
  font-weight: 800;
}
.classify-box .circt-title .left text {
  font-weight: normal;
}
.classify-box .circt-title .right {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #A8A8A8;
}
.classify-box .circt-box {
  margin-top: 12rpx;
}
.classify-box .circt-box .circt-item {
  padding: 28rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid #E6E6E6;
}
.classify-box .circt-box .circt-item .top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.classify-box .circt-box .circt-item .top .left {
  font-size: 28rpx;
  color: #666666;
  display: flex;
  align-items: center;
}
.classify-box .circt-box .circt-item .top .left > image {
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  border-radius: 50%;
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}
.classify-box .circt-box .circt-item .top .right {
  font-size: 24rpx;
  color: #B3B3B3;
}
.classify-box .circt-box .circt-item .bottom {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #221F1C;
  text-align: justify;
}
.classify-box .circt-box .circt-item:last-child {
  border-bottom: none;
}
