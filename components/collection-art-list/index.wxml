<view class="news-list-wrap wr-class" id="{{independentID}}">
  <block wx:for="{{goodsList}}" wx:for-item="item" wx:key="index">
    <view class="news-item">
      <view class="left" bindtap="handleGoArt" data-id="{{item.id}}">
        <view class="title">{{item.title}}</view>
        <view class="time">
          <view class="left-num">
            <image src="{{item.shop_logo}}"></image>
            <view class="desc">{{item.shop_name}}</view>
            <view class="min">{{item.ctime}}</view>
          </view>
          <view class="right-num">
            <t-icon style="margin-right: 10rpx;" name="browse" color="#A8A8A8 " size="30rpx" /><text>{{item.hits}}</text>
          </view>
        </view>
      </view>
      <image src="{{item.pic}}" class="right" bindtap="handleGoArt" data-id="{{item.id}}"></image>
      <t-icon class="action" name="more" size="38rpx" color="#aaa" bind:click="onIconTap" data-id="{{item.id}}" />
    </view>

  </block>
</view>