.fwtit {
  margin: 50rpx 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.fwtit .left {
  padding-left: 20rpx;
  position: relative;
  font-weight: bold;
  font-size: 36rpx;
  color: #221F1C;
}
.fwtit .left::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 10rpx;
  height: 35rpx;
  background: #FF5533;
  border-radius: 4rpx;
}
.fwtit .right {
  font-size: 30rpx;
  color: #919B9D;
}
.fwtit .right image {
  width: 28rpx;
  height: 28rpx;
}
.tabler {
  background: #FFFFFF;
  --td-tab-nav-bg-color: transparent;
  --td-tab-border-color: transparent;
  --td-tab-item-color: #999999;
  --td-tab-item-active-color: #F22800;
  --td-tab-track-width: 0rpx;
  --td-tab-font-size: 30rpx;
}
.fwstorelist {
  margin: 30rpx 20rpx;
}
.fwstorelist .fw-items {
  background: #FFFFFF;
  margin: 10rpx 0;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.fwstorelist .fw-items .img {
  padding: 10rpx;
  border-radius: 10rpx;
  border: 1rpx solid #E6E6E6;
}
.fwstorelist .fw-items .img image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
}
.fwstorelist .fw-items .txt .tit {
  font-weight: bold;
  font-size: 32rpx;
  color: #221F1C;
}
.fwstorelist .fw-items .txt .tags {
  margin: 15rpx 0;
}
.fwstorelist .fw-items .txt .tags text {
  padding: 5rpx;
  background: #FFF2F0;
  border-radius: 4rpx;
  font-size: 24rpx;
  color: #FF5533;
}
.fwstorelist .fw-items .txt .address {
  font-size: 24rpx;
  color: #999999;
}
.fwstorelist .fw-items .txt .address image {
  margin-right: 10rpx;
  width: 24rpx;
  height: 24rpx;
}
